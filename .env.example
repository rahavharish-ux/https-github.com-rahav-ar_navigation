# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real API keys. See SETUP.md for how to get a key.

# Google Cloud API key with "Places API (New)" enabled and billing set
# up. Also used as the Android Maps SDK key (see
# android/local.properties.example) and, once obtained, the iOS Maps SDK
# key (see ios/Runner/AppDelegate.swift).
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Supabase project (Phase 14) -- Settings -> API Keys in the Supabase
# dashboard. SUPABASE_PUBLISHABLE_KEY is the "Publishable key"
# (sb_publishable_...) -- Supabase's current name for what used to be
# called the "anon" key. Safe to ship in a client app (real access
# control is enforced by Postgres Row Level Security policies, not by
# keeping this key secret) -- never use a "Secret key" (sb_secret_...,
# the old "service_role" key) here.
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY_HERE
